# Telegram Bot example environment
# Copy this to .env and fill secret values.

API_ID=123456
API_HASH=your_api_hash_here
SESSION_NAME=session_telegram_bot
ALERT_BOT_TOKEN=your_alert_bot_token
ALERT_CHAT_ID=123456789
TELEGRAM_ADMIN_ID=123456789

# Telegram runtime
TELEGRAM_AUTO_RECONNECT=true
TELEGRAM_CONNECTION_RETRIES=5
TELEGRAM_MAX_RECONNECT_ATTEMPTS=50
TELEGRAM_REQUEST_TIMEOUT=20.0
TELEGRAM_CONNECT_TIMEOUT=30.0
TELEGRAM_HEARTBEAT_TIMEOUT=8.0
TELEGRAM_CHANNEL_TIMEOUT=10.0
TELEGRAM_SYNC_DIALOGS=true
TELEGRAM_LOG_ALL_INGRESS=false
TELEGRAM_FILTER_AT_SOURCE=false
TELEGRAM_INBOX_DB_PATH=data/telegram_inbox.db
CHANNEL_POLL_INTERVAL=1.0
CHANNEL_POLL_REQUEST_TIMEOUT=5.0
CHANNEL_POLL_MAX_INFLIGHT=3
CODE_MAX_AGE_SECONDS=120

# Logging / database
LOG_LEVEL=INFO
LOG_FILE=logs/bot_activity.log
DATABASE_PATH=data/code_history.db

# Browser / CDP
EDGE_CDP_HOST=127.0.0.1
EDGE_CDP_PORT=9222
EDGE_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
AUTO_OPEN_MISSING_TABS=true

# Concurrency
MAX_CONCURRENT_PROCESSING=50
MESSAGE_WORKERS=6
MAX_CONCURRENT_SUBMITS=8
MAX_CONCURRENT_SUBMITS_PER_DOMAIN=2
MAX_CONCURRENT_MEDIA_DOWNLOADS=4
MAX_CONCURRENT_OCR=2

# Queueing
MESSAGE_QUEUE_MAXSIZE=2000
DOMAIN_QUEUE_MAXSIZE=500
QUEUE_CHECK_INTERVAL=5.0
QUEUE_SOFT_LIMIT_PCT=0.75
QUEUE_HARD_LIMIT_PCT=0.95

# OCR / media
FAST_TELEGRAM_DOWNLOAD=true
OCR_MAX_IMAGE_SIDE=1024
OCR_CONFIDENCE_THRESHOLD=0.70
OCR_FAST_PATH=true

# Retry / rate limit
REQUESTS_PER_MINUTE=30
MAX_BURST=5
RATE_LIMIT_BACKOFF_SECONDS=5.0
MAX_RETRIES_PER_ACCOUNT=1
RETRY_ON_TIMEOUT=true
MAX_INBOX_ATTEMPTS=5
INBOX_RETRY_BASE_DELAY=2.0
INBOX_RETRY_MAX_DELAY=120.0

# Accounts / codes
ACCOUNTS_PER_CODE=2
SINGLE_ROUND_PER_BATCH=false
ACTIVE_DOMAINS=hi88,qq88,o8,mm88,rr88,xx88,gg88

# Channels config
# ids are examples and should match your Telegram list.
CHANNEL_XX88_1=-1002817093108
CHANNEL_XX88_2=-1002768264448
CHANNEL_MM88_1=-1003134541072
CHANNEL_RR88_1=-1002386905514
CHANNEL_GG88_1=-1003731231345
CHANNEL_QQ88_1=-1002421765170
CHANNEL_HI88_1=-1004435825431

# Optional features
DEBUG_VERBOSE_MODE=false
SPOILER_FAST_PATH=true
