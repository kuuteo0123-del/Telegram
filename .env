# Production configuration — LOW RAM / 10 WARM TABS (31 kênh, 7 site)
# BẢO MẬT: file này chứa khóa đăng nhập thật. Không gửi cho ai, không đưa vào Git/zip.

# ── Telegram credentials ─────────────────────────────────────────────
API_ID=31560637
# >>> ĐIỀN LẠI giá trị của bạn cho 2 dòng dưới (file này cố ý để trống) <<<
API_HASH=
SESSION_NAME=session_babao_bot
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=8279295717
TELEGRAM_ADMIN_ID=8279295717
SUBMIT_SUCCESS_CHAT_ID=8279295717

# ── Telegram runtime ─────────────────────────────────────────────────
TELEGRAM_AUTO_RECONNECT=true
TELEGRAM_CONNECTION_RETRIES=5
# Số lần tự nối lại trước khi bot bỏ cuộc
TELEGRAM_MAX_RECONNECT_ATTEMPTS=50
TELEGRAM_REQUEST_TIMEOUT=20.0
TELEGRAM_CONNECT_TIMEOUT=30.0
TELEGRAM_HEARTBEAT_TIMEOUT=8.0
TELEGRAM_CHANNEL_TIMEOUT=10.0
TELEGRAM_SYNC_DIALOGS=true
TELEGRAM_CATCH_UP=false
# Code luôn nhận rộng rồi tự lọc theo 31 kênh; biến này bị bỏ qua
TELEGRAM_FILTER_AT_SOURCE=false
TELEGRAM_LOG_ALL_INGRESS=true
TELEGRAM_INBOX_DB_PATH=data/telegram_inbox.db
TELEGRAM_INBOX_DRAIN_BATCH=250
TELEGRAM_INBOX_DRAIN_INTERVAL=0.05
TELEGRAM_INBOX_ENQUEUE_RETRIES=3
TELEGRAM_INBOX_LEASE_SECONDS=300
TELEGRAM_INBOX_RECOVERY_MODE=at_least_once
HI88_CHAT_IDS=
QQ88_CHAT_IDS=
# OCR chỉ kênh PHÁT CODE XX88 (code cũng khóa cứng kênh này)
OCR_ALLOWED_CHANNEL_IDS=-1002817093108
OCR_MEDIA_FALLBACK_CHANNEL_IDS=-1002817093108
OCR_MEDIA_ONLY_CHANNEL_IDS=-1002817093108

# ── Bộ quét kênh (nguồn nhận tin chính; push của Telegram về trễ vài phút) ──
# Bắn 1 request mỗi N giây (giây; 0 = tắt). Nếu log [Poll-Stat] có nhiều timeout
# hoặc có FloodWait thì tăng lên 2-3.
CHANNEL_POLL_INTERVAL=1.0
# Request quét treo quá số giây này thì bỏ (cũ: 10.0 -> ~40% request treo chiếm slot)
CHANNEL_POLL_REQUEST_TIMEOUT=5.0
# Số request quét được chờ song song tối đa (cũ: 2). Nếu có FloodWait thì đặt lại 2
CHANNEL_POLL_MAX_INFLIGHT=3
# Timeout khi phải gọi thêm get_messages (nhiều tin mới cùng lúc, vd album)
CHANNEL_POLL_FETCH_TIMEOUT=12.0
# Số lần poll timeout liên tiếp trước khi đóng connection để reconnect (cũ: 5 -> bị reconnect liên tục)
TELEGRAM_POLL_FAILURE_RECONNECT_AFTER=15
# Tin cũ hơn số giây này (tính từ lúc đăng) bị bỏ, không nhập
CODE_MAX_AGE_SECONDS=120

# ── Logging / database ───────────────────────────────────────────────
LOG_LEVEL=INFO
FILE_LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=INFO
LOG_FILE=logs/bot_activity.log
LOG_USE_UTC=false
COMPACT_CONSOLE_LOG=true
CONSOLE_SUMMARY_ONLY=true
LOG_ROTATION_MAX_BYTES=10485760
LOG_ROTATION_BACKUP_COUNT=5
DATABASE_PATH=data/code_history.db

# ── Browser / CDP (chỉ loopback) ─────────────────────────────────────
EDGE_CDP_HOST=127.0.0.1
EDGE_CDP_PORT=9222
EDGE_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
EDGE_PROFILE_DIR=
EDGE_PROFILE_NAME=Default
STEALTH_JS_ENABLED=false
CDP_PING_INTERVAL=60.0
EDGE_CDP_WATCHDOG_INTERVAL=5.0
AUTO_OPEN_MISSING_TABS=true

# ── 11 tab nóng: XX88x2, MM88x2, RR88x2, GG88x2, O8x1, QQ88x1, HI88x1 ─
TAB_POOL_SIZE=2
MAX_TAB_PER_DOMAIN_CAP=2
TAB_POOL_MIN_TABS_PER_DOMAIN=1
TAB_POOL_IDLE_TTL=86400
TAB_POOL_MEMORY_COMPACT_IDLE_SECONDS=120
TAB_POOL_MEMORY_RELOAD_IDLE_SECONDS=1800
TAB_ACQUIRE_WAIT_SECONDS=15.0

# ── Giới hạn nhập mã (tab giữ nóng; tối đa 8 lượt nhập cùng lúc) ─────
MAX_CONCURRENT_SUBMITS=8
MAX_CONCURRENT_SUBMITS_PER_DOMAIN=2
SUBMIT_TIMEOUT_SECONDS=45
PAGE_NAVIGATION_TIMEOUT=15000
FORM_SETTLE_SECONDS=0.03
MM88_FORM_SETTLE_SECONDS=0.05
CF_WAIT_SECONDS=1.0
CF_POLL_INTERVAL=0.05
RESULT_POLL_INTERVAL=0.05
RESULT_SELECTOR_FAST_WINDOW_SECONDS=0.80
RESULT_DETECTION_TIMEOUT=7000
QQ88_RESULT_DETECTION_TIMEOUT=3500
HI88_RESULT_DETECTION_TIMEOUT=4500
MM88_RESULT_DETECTION_TIMEOUT=4000
RR88_RESULT_DETECTION_TIMEOUT=3000
XX88_RESULT_DETECTION_TIMEOUT=3500
GG88_RESULT_DETECTION_TIMEOUT=3500
O8_RESULT_DETECTION_TIMEOUT=3000
FULL_RELOAD_EVERY_N=100
SCREENSHOT_ON_UNKNOWN=true
PRESERVE_PREFILLED_USERNAME=true
# Tùy chọn (mặc định trong config.py: 8.0 và 90.0):
# TURNSTILE_SOLVE_WAIT_SECONDS=8.0
# PENDING_VERIFY_WATCH_SECONDS=90.0

# ── Hàng đợi / backpressure ──────────────────────────────────────────
MESSAGE_WORKERS=6
MAX_CONCURRENT_PROCESSING=50
MAX_CONCURRENT_INGRESS_TASKS=256
MESSAGE_QUEUE_MAXSIZE=2000
DOMAIN_QUEUE_MAXSIZE=500
QUEUE_CHECK_INTERVAL=5.0
QUEUE_SOFT_LIMIT_PCT=0.75
QUEUE_HARD_LIMIT_PCT=0.95
QUEUE_CLEANUP_ON_SOFT_LIMIT=false
QUEUE_CLEANUP_TARGET_PCT=0.50

# ── OCR / media (chỉ dùng cho kênh PHÁT CODE XX88) ───────────────────
MAX_CONCURRENT_OCR=2
MAX_CONCURRENT_MEDIA_DOWNLOADS=4
FAST_TELEGRAM_DOWNLOAD=true
FAST_DOWNLOAD_WORKERS=8
FAST_DOWNLOAD_CHUNK_KB=512
FAST_DOWNLOAD_MIN_BYTES=1048576
MEDIA_DOWNLOAD_MAX_SIZE_MB=200
MEDIA_DOWNLOAD_RETRIES=1
MEDIA_DOWNLOAD_RETRY_DELAY=0.5
OCR_MAX_IMAGE_SIDE=1024
OCR_DET_LIMIT_SIDE=512
OCR_MIN_CROP_WIDTH=300
OCR_CROP_FALLBACK=false
OCR_FAST_PATH=true
OCR_FAST_MIN_CHARS=8
OCR_FAST_VARIANTS=1
VIDEO_OCR_MAX_FRAMES=3
MAX_OCR_CODES_PER_BATCH=4
OCR_CONFIDENCE_THRESHOLD=0.70
OCR_DEBUG_SAVE_FRAMES=false
# Bật true trong vài lần chạy để đo thời gian OCR rồi gửi log tinh chỉnh
OCR_DEBUG_TIMING=false
OCR_FALLBACK_ALL_MEDIA=false
OCR_CACHE_MAX_ENTRIES=64
OCR_CACHE_TTL_SECONDS=600
PAUSE_OCR_ON_HIGH_CPU=true
OCR_CPU_THRESHOLD=85
OCR_RAM_WARN_THRESHOLD=85
OCR_RAM_PAUSE_THRESHOLD=90
PENDING_VERIFICATION_RETRY=false
PENDING_DOMAIN_COOLDOWN_SECONDS=45
# false: tin nhiều mã vẫn nhập đủ (mã dư xếp hàng). true: mã dư bị bỏ
SINGLE_ROUND_PER_BATCH=false

# ── Retry / rate limit (mỗi site) ────────────────────────────────────
REQUESTS_PER_MINUTE=30
MAX_BURST=5
# Ghi đè riêng từng site nếu cần (mặc định lấy 2 giá trị trên), ví dụ:
# XX88_REQUESTS_PER_MINUTE=60
# XX88_MAX_BURST=10
# Tương tự: GG88_, MM88_, RR88_, QQ88_, HI88_, O8_ + REQUESTS_PER_MINUTE / MAX_BURST
RATE_LIMIT_BACKOFF_SECONDS=5.0
MAX_RETRIES_PER_ACCOUNT=1
RETRY_ON_TIMEOUT=true
MAX_INBOX_ATTEMPTS=5
INBOX_RETRY_BASE_DELAY=2.0
INBOX_RETRY_MAX_DELAY=120.0
INBOX_MAX_PENDING_AGE_SECONDS=900.0
INBOX_PENDING_SWEEP_INTERVAL_SECONDS=300.0

# ── Health / session / bảo trì ───────────────────────────────────────
HEALTH_CHECK_INTERVAL=30.0
HEALTH_BREACH_CONFIRM_COUNT=2
HEARTBEAT_INTERVAL=300.0
BROWSER_CIRCUIT_FAILURE_THRESHOLD=3
BROWSER_CIRCUIT_COOLDOWN_SECONDS=60.0
SESSION_AUTO_BACKUP=true
SESSION_BACKUP_DIR=backups/sessions
SESSION_DELETE_AFTER_BACKUP=false
SHUTDOWN_MESSAGE_DRAIN_TIMEOUT=8.0
INPUT_CACHE_CLEANUP_INTERVAL=30.0
SITE_CODE_DEDUP_TTL=300.0
SUBMIT_SUCCESS_NOTIFY=false
VERIFICATION_BUTTON_WAIT_SECONDS=1.0
ACCOUNTS_PER_CODE=2

# ── Khác ─────────────────────────────────────────────────────────────
DEBUG_VERBOSE_MODE=false
LOG_DIR=logs
ALERT_HTTP_TIMEOUT=10.0
ACTIVE_DOMAINS=hi88,qq88,o8,mm88,rr88,xx88,gg88
SPOILER_FAST_PATH=true
